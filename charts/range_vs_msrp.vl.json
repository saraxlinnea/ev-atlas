{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "EPA range vs MSRP",
    "subtitle": "US-market rows with both a sourced USD MSRP and EPA range. Blank and non-US rows are omitted, not plotted as zero. No CNY→USD conversion.",
    "fontSize": 16,
    "subtitleFontSize": 11,
    "subtitleColor": "#666"
  },
  "data": { "url": "../data/flattened.csv" },
  "transform": [
    {
      "filter": "(datum.region === 'US' || datum.region === '' || datum.region === null) && isValid(datum['identity.msrp_usd']) && isValid(datum['efficiency.epa_range_mi']) && datum['identity.msrp_usd'] !== '' && datum['efficiency.epa_range_mi'] !== ''"
    },
    {
      "calculate": "datum.make + ' ' + datum.model",
      "as": "label"
    },
    {
      "calculate": "toNumber(datum['identity.msrp_usd'])",
      "as": "msrp_usd"
    },
    {
      "calculate": "toNumber(datum['efficiency.epa_range_mi'])",
      "as": "epa_range_mi"
    },
    {
      "calculate": "datum['identity.msrp_usd__tier']",
      "as": "msrp_tier"
    },
    {
      "calculate": "datum['efficiency.epa_range_mi__tier']",
      "as": "range_tier"
    }
  ],
  "width": 640,
  "height": 420,
  "mark": {
    "type": "point",
    "filled": true,
    "size": 90,
    "opacity": 0.85
  },
  "encoding": {
    "x": {
      "field": "msrp_usd",
      "type": "quantitative",
      "title": "MSRP (USD)",
      "scale": { "zero": false },
      "axis": { "format": "~s" }
    },
    "y": {
      "field": "epa_range_mi",
      "type": "quantitative",
      "title": "EPA range (mi)",
      "scale": { "zero": false }
    },
    "color": {
      "field": "make",
      "type": "nominal",
      "title": "Make"
    },
    "tooltip": [
      { "field": "label", "title": "Vehicle" },
      { "field": "trim", "title": "Trim" },
      { "field": "model_year", "title": "Model year" },
      { "field": "msrp_usd", "title": "MSRP (USD)", "type": "quantitative", "format": "," },
      { "field": "msrp_tier", "title": "MSRP tier" },
      { "field": "epa_range_mi", "title": "EPA range (mi)", "type": "quantitative" },
      { "field": "range_tier", "title": "Range tier" }
    ]
  },
  "config": {
    "view": { "stroke": null },
    "axis": { "labelFontSize": 11, "titleFontSize": 12 }
  }
}
