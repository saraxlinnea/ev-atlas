{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Curb weight vs wall-side efficiency",
    "subtitle": "US-market rows with both a sourced curb weight and EPA wall-side kWh/100 mi. Wall-side includes charging losses. Blank and non-US rows are omitted.",
    "fontSize": 16,
    "subtitleFontSize": 11,
    "subtitleColor": "#666"
  },
  "data": { "url": "../data/flattened.csv" },
  "transform": [
    {
      "filter": "(datum.region === 'US' || datum.region === '' || datum.region === null) && isValid(datum['body.curb_weight_lb']) && isValid(datum['efficiency.epa_kwh_per_100mi']) && datum['body.curb_weight_lb'] !== '' && datum['efficiency.epa_kwh_per_100mi'] !== ''"
    },
    {
      "calculate": "datum.make + ' ' + datum.model",
      "as": "label"
    },
    {
      "calculate": "toNumber(datum['body.curb_weight_lb'])",
      "as": "curb_weight_lb"
    },
    {
      "calculate": "toNumber(datum['efficiency.epa_kwh_per_100mi'])",
      "as": "epa_kwh_per_100mi"
    },
    {
      "calculate": "datum['body.curb_weight_lb__tier']",
      "as": "weight_tier"
    },
    {
      "calculate": "datum['efficiency.epa_kwh_per_100mi__tier']",
      "as": "efficiency_tier"
    }
  ],
  "width": 640,
  "height": 420,
  "mark": {
    "type": "point",
    "filled": true,
    "size": 90,
    "opacity": 0.85
  },
  "encoding": {
    "x": {
      "field": "curb_weight_lb",
      "type": "quantitative",
      "title": "Curb weight (lb)",
      "scale": { "zero": false }
    },
    "y": {
      "field": "epa_kwh_per_100mi",
      "type": "quantitative",
      "title": "EPA kWh/100mi (wall-side)",
      "scale": { "zero": false }
    },
    "color": {
      "field": "make",
      "type": "nominal",
      "title": "Make"
    },
    "tooltip": [
      { "field": "label", "title": "Vehicle" },
      { "field": "trim", "title": "Trim" },
      { "field": "model_year", "title": "Model year" },
      { "field": "curb_weight_lb", "title": "Curb weight (lb)", "type": "quantitative" },
      { "field": "weight_tier", "title": "Weight tier" },
      { "field": "epa_kwh_per_100mi", "title": "kWh/100mi (wall-side)", "type": "quantitative", "format": ".2f" },
      { "field": "efficiency_tier", "title": "Efficiency tier" }
    ]
  },
  "config": {
    "view": { "stroke": null },
    "axis": { "labelFontSize": 11, "titleFontSize": 12 }
  }
}
